# Copy to .env and adjust. Paths are relative to the repo root.
RAW_DATA_PATH=data/raw/sample_data.csv
PROCESSED_DIR=data/processed
STORE_DB_PATH=data/store/sciplay.sqlite
MODEL_DIR=models
# Optional: default score date for the daily pipeline (YYYY-MM-DD). Empty = latest date in data.
SCORE_DATE=
# Optional: only needed if the LLM summary is enabled. Template fallback is used otherwise.
LLM_API_KEY=
